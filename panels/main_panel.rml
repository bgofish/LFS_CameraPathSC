<rml>
<head>
  <link type="text/rcss" href="main_panel.rcss"/>
</head>
<body id="body" class="plugin-panel CameraPathSC-panel" data-model="campath_json">
  <div class="panel-shell">
    <div class="panel-header">
      <span class="panel-kicker">Camera Tools</span>
      <span class="panel-title">Camera Path SC</span>
      <span class="panel-note">Native JSON camera path generator for LichtFeld Studio.</span>
    </div>

    <!-- ================= Animation ================= -->
    <div class="section">
      <div class="section-header" data-event-click="sec_anim = !sec_anim">
        <span class="section-arrow" data-class-open="sec_anim">&#9656;</span>
        <span class="section-title">Animation</span>
      </div>
      <div class="section-body" data-if="sec_anim">

        <div class="field-row">
          <span class="field-label">Type</span>
          <div class="option-group">
            <div class="option-item" data-event-click="anim_type = 'circular'">
              <span class="option-box radio" data-class-checked="anim_type == 'circular'"></span>
              <span>Circular</span>
            </div>
            <div class="option-item" data-event-click="anim_type = 'spiral'">
              <span class="option-box radio" data-class-checked="anim_type == 'spiral'"></span>
              <span>Spiral</span>
            </div>
          </div>
        </div>

        <div class="field-row">
          <span class="field-label">Direction</span>
          <div class="option-group">
            <div class="option-item" data-event-click="direction = 'clockwise'">
              <span class="option-box radio" data-class-checked="direction == 'clockwise'"></span>
              <span>Clockwise</span>
            </div>
            <div class="option-item" data-event-click="direction = 'ccw'">
              <span class="option-box radio" data-class-checked="direction == 'ccw'"></span>
              <span>Counter-clockwise</span>
            </div>
          </div>
        </div>

        <div data-if="!is_spiral">
          <div class="field-row">
            <span class="field-label">Radius (m)</span>
            <div class="slider-combo">
              <input type="range" class="field-slider" min="0.1" max="200" step="0.1" data-value="radius"/>
              <input type="text" class="field-input slider-text" data-value="radius_text"/>
            </div>
          </div>
          <div data-if="radius_idle" class="button-row">
            <button class="action-button pick" data-event-click="pick_radius" title="Click a point on the model; radius is computed as the horizontal distance from the Orbit Centre.">Pick Point (from Orbit Centre)</button>
            <button class="action-button update" data-event-click="update_radius" title="Move the radius marker to match the current Radius value (extrapolated along the last picked direction from Orbit Centre).">Update</button>
            <button class="action-button edit" data-event-click="edit_radius" title="Place a drag gizmo at the radius point; dragging it updates Radius live.">Edit</button>
          </div>
          <div data-if="picking_radius" class="button-row">
            <button class="action-button danger" data-event-click="stop_pick_target" title="Stop picking.">Stop Picking</button>
          </div>
          <div data-if="editing_radius" class="button-row">
            <button class="action-button danger" data-event-click="stop_edit_target" title="Remove the drag gizmo and keep the current values.">Stop Editing</button>
          </div>
        </div>

        <div data-if="is_spiral">
          <div class="field-row">
            <span class="field-label">Loops</span>
            <div class="slider-combo">
              <input type="range" class="field-slider" min="0.1" max="20" step="0.1" data-value="loops"/>
              <input type="text" class="field-input slider-text" data-value="loops_text"/>
            </div>
          </div>
          <div class="field-row">
            <span class="field-label">Start Radius (m)</span>
            <div class="slider-combo">
              <input type="range" class="field-slider" min="0" max="200" step="0.1" data-value="start_radius"/>
              <input type="text" class="field-input slider-text" data-value="start_radius_text"/>
            </div>
          </div>
          <div class="field-row">
            <span class="field-label">End Radius (m)</span>
            <div class="slider-combo">
              <input type="range" class="field-slider" min="0" max="200" step="0.1" data-value="end_radius"/>
              <input type="text" class="field-input slider-text" data-value="end_radius_text"/>
            </div>
          </div>
          <div class="field-row">
            <span class="field-label">Start Height (m)</span>
            <div class="slider-combo">
              <input type="range" class="field-slider" min="-100" max="100" step="0.1" data-value="start_height"/>
              <input type="text" class="field-input slider-text" data-value="start_height_text"/>
            </div>
          </div>
          <div class="field-row">
            <span class="field-label">End Height (m)</span>
            <div class="slider-combo">
              <input type="range" class="field-slider" min="-100" max="100" step="0.1" data-value="end_height"/>
              <input type="text" class="field-input slider-text" data-value="end_height_text"/>
            </div>
          </div>

          <div class="field-row">
            <div class="option-item" data-event-click="follow_y = !follow_y">
              <span class="option-box checkbox" data-class-checked="follow_y"></span>
              <span>Target follows camera height</span>
            </div>
          </div>

          <div data-if="follow_y" class="field-row">
            <span class="field-label">Height Offset (m)</span>
            <div class="slider-combo">
              <input type="range" class="field-slider" min="-100" max="100" step="0.1" data-value="y_offset"/>
              <input type="text" class="field-input slider-text" data-value="y_offset_text"/>
            </div>
          </div>
          <p data-if="!follow_y" class="section-hint">(enable "Target follows camera height" to set an offset)</p>
        </div>

      </div>
    </div>

    <!-- ================= Orbit Centre ================= -->
    <div class="section">
      <div class="section-header" data-event-click="sec_centre = !sec_centre">
        <span class="section-arrow" data-class-open="sec_centre">&#9656;</span>
        <span class="section-title">Orbit Centre</span>
      </div>
      <div class="section-body" data-if="sec_centre">
        <div class="field-row">
          <span class="field-label">X</span>
          <div class="slider-combo">
            <input type="range" class="field-slider" min="-500" max="500" step="0.1" data-value="cx"/>
            <input type="text" class="field-input slider-text" data-value="cx_text"/>
          </div>
        </div>
        <div class="field-row">
          <span class="field-label">Y</span>
          <div class="slider-combo">
            <input type="range" class="field-slider" min="-500" max="500" step="0.1" data-value="cy"/>
            <input type="text" class="field-input slider-text" data-value="cy_text"/>
          </div>
        </div>
        <div class="field-row">
          <span class="field-label">Z</span>
          <div class="slider-combo">
            <input type="range" class="field-slider" min="-500" max="500" step="0.1" data-value="cz"/>
            <input type="text" class="field-input slider-text" data-value="cz_text"/>
          </div>
        </div>
        <div data-if="centre_idle" class="button-row">
          <button class="action-button pick" data-event-click="pick_centre" title="Click on the model to set the orbit centre.">Pick Point</button>
          <button class="action-button update" data-event-click="update_centre" title="Move the marker in the viewport to match the current X/Y/Z values.">Update</button>
          <button class="action-button edit" data-event-click="edit_centre" title="Place a drag gizmo at the orbit centre; dragging it updates X/Y/Z live.">Edit</button>
        </div>
        <div data-if="picking_centre" class="button-row">
          <button class="action-button danger" data-event-click="stop_pick_target" title="Stop picking.">Stop Picking</button>
        </div>
        <div data-if="editing_centre" class="button-row">
          <button class="action-button danger" data-event-click="stop_edit_target" title="Remove the drag gizmo and keep the current values.">Stop Editing</button>
        </div>
      </div>
    </div>

    <!-- ================= Look Target ================= -->
    <div class="section">
      <div class="section-header" data-event-click="sec_target = !sec_target">
        <span class="section-arrow" data-class-open="sec_target">&#9656;</span>
        <span class="section-title">Look Target</span>
      </div>
      <div class="section-body" data-if="sec_target">
        <div class="field-row">
          <div class="option-item" data-event-click="auto_target = !auto_target">
            <span class="option-box checkbox" data-class-checked="auto_target"></span>
            <span>Auto-target (use orbit centre)</span>
          </div>
        </div>
        <div data-if="!auto_target">
          <div class="field-row">
            <span class="field-label">X</span>
            <div class="slider-combo">
              <input type="range" class="field-slider" min="-500" max="500" step="0.1" data-value="tx"/>
              <input type="text" class="field-input slider-text" data-value="tx_text"/>
            </div>
          </div>
          <div class="field-row">
            <span class="field-label">Y</span>
            <div class="slider-combo">
              <input type="range" class="field-slider" min="-500" max="500" step="0.1" data-value="ty"/>
              <input type="text" class="field-input slider-text" data-value="ty_text"/>
            </div>
          </div>
          <div class="field-row">
            <span class="field-label">Z</span>
            <div class="slider-combo">
              <input type="range" class="field-slider" min="-500" max="500" step="0.1" data-value="tz"/>
              <input type="text" class="field-input slider-text" data-value="tz_text"/>
            </div>
          </div>
          <div data-if="target_idle" class="button-row">
            <button class="action-button pick" data-event-click="pick_target" title="Click on the model to set the look target. Turns off Auto-target.">Pick Point</button>
            <button class="action-button update" data-event-click="update_target" title="Move the marker in the viewport to match the current X/Y/Z values.">Update</button>
            <button class="action-button edit" data-event-click="edit_target" title="Place a drag gizmo at the look target; dragging it updates X/Y/Z live. Turns off Auto-target.">Edit</button>
          </div>
          <div data-if="picking_target" class="button-row">
            <button class="action-button danger" data-event-click="stop_pick_target" title="Stop picking.">Stop Picking</button>
          </div>
          <div data-if="editing_target" class="button-row">
            <button class="action-button danger" data-event-click="stop_edit_target" title="Remove the drag gizmo and keep the current values.">Stop Editing</button>
          </div>
        </div>
      </div>
    </div>

    <!-- ================= Camera & Timing ================= -->
    <div class="section">
      <div class="section-header" data-event-click="sec_camera = !sec_camera">
        <span class="section-arrow" data-class-open="sec_camera">&#9656;</span>
        <span class="section-title">Camera &amp; Timing</span>
      </div>
      <div class="section-body" data-if="sec_camera">
        <div class="field-row">
          <span class="field-label">Frames</span>
          <div class="slider-combo">
            <input type="range" class="field-slider" min="1" max="3000" step="1" data-value="frames"/>
            <input type="text" class="field-input slider-text" data-value="frames_text"/>
          </div>
        </div>
        <div class="field-row">
          <span class="field-label">FPS</span>
          <div class="slider-combo">
            <input type="range" class="field-slider" min="1" max="240" step="1" data-value="fps"/>
            <input type="text" class="field-input slider-text" data-value="fps_text"/>
          </div>
        </div>
        <p class="derived-text">{{ duration_text }}</p>

        <div class="field-row">
          <span class="field-label">Focal Length (mm)</span>
          <div class="slider-combo">
            <input type="range" class="field-slider" min="1" max="300" step="0.5" data-value="focal_length"/>
            <input type="text" class="field-input slider-text" data-value="focal_length_text"/>
          </div>
        </div>
        <div class="field-row">
          <span class="field-label">Sensor Width (mm)</span>
          <div class="slider-combo">
            <input type="range" class="field-slider" min="1" max="100" step="0.5" data-value="sensor_size"/>
            <input type="text" class="field-input slider-text" data-value="sensor_size_text"/>
          </div>
        </div>
        <p class="derived-text">{{ fov_text }}</p>
      </div>
    </div>

    <!-- ================= Export Options ================= -->
    <div class="section">
      <div class="section-header" data-event-click="sec_export = !sec_export">
        <span class="section-arrow" data-class-open="sec_export">&#9656;</span>
        <span class="section-title">Export Options</span>
      </div>
      <div class="section-body" data-if="sec_export">
        <div class="field-row">
          <span class="field-label">Keyframe N Frames</span>
          <div class="slider-combo">
            <input type="range" class="field-slider" min="1" max="60" step="1" data-value="keyframe_step"/>
            <input type="text" class="field-input slider-text" data-value="keyframe_step_text"/>
          </div>
        </div>
        <p class="warning-text" data-if="keyframe_warning_text != ''">{{ keyframe_warning_text }}</p>
        <div class="field-row">
          <span class="field-label">Decimal Precision</span>
          <div class="slider-combo">
            <input type="range" class="field-slider" min="0" max="10" step="1" data-value="precision"/>
            <input type="text" class="field-input slider-text" data-value="precision_text"/>
          </div>
        </div>
        <div class="field-row">
          <span class="field-label">Output File (.json)</span>
          <input type="text" class="field-input wide" data-value="output_path"/>
        </div>
        <button id="btn-generate" class="action-button primary">Generate JSON</button>
      </div>
    </div>

    <!-- ================= Sequencer ================= -->
    <div class="section">
      <div class="section-header" data-event-click="sec_sequencer = !sec_sequencer">
        <span class="section-arrow" data-class-open="sec_sequencer">&#9656;</span>
        <span class="section-title">Sequencer</span>
      </div>
      <div class="section-body" data-if="sec_sequencer">
        <p class="section-hint">Loading overwrites the sequencer's current path — back it up first if needed.</p>
        <div class="button-row">
          <button id="btn-load" class="action-button">Load into Sequencer</button>
          <button id="btn-backup" class="action-button secondary">Backup Sequencer</button>
        </div>
      </div>
    </div>

    <!-- ================= Status ================= -->
    <p class="status-text" data-class-error="!status_ok" data-if="status != ''">{{ status }}</p>

  </div>
</body>
</rml>
